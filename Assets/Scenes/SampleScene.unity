  headerFontSize: 16
  titleFontSize: 24
  subtitleFontSize: 15
  bodyFontSize: 15
  buttonFontSize: 17
  cardData:
  - title: "Zombie Asam  \u2014  Sifat: Korosif & pH Rendah"
    subtitle: 'Sifat: Korosif & pH rendah (asam kuat)'
    titleColor: {r: 0, g: 0, b: 0, a: 0}
    chemicalDescription: 'Sifat: Korosif & pH rendah (asam kuat)'
    weaknessText: "<b><color=#81C784>\u2022 KELEMAHAN (EFEKTIF MENETRALKAN):</color></b>\n\u2022
      <b>Busa Sabun Mengembang</b> (Basa + Katalis) & <b>Bom Netralisasi</b>.\n\u2022
      Reaksi netralisasi cepat merusak inti asam dan mementalkan zombie dengan knockback
      kuat!"
    mutationRiskText: "<b><color=#E57373>\u2022 PANTANGAN (RISIKO MUTASI):</color></b>\n\u2022
      <b>Ramuan Asam</b> (Kabut Asam Dingin / Asam Pelarut Karat).\n\u2022 Kebal
      asam! Menyiram asam justru memperkuat ion tubuhnya dan memicu <b>Mutasi Membesar
      (Enlarge +50% HP)</b>."
    buttonLabel: LANJUT  [SPACE]
  - title: "Zombie Basa  \u2014  Sifat: Alkali Licin & pH Tinggi"
    subtitle: 'Sifat: Alkali licin & pH tinggi'
    titleColor: {r: 0, g: 0, b: 0, a: 0}
    chemicalDescription: 'Sifat: Alkali licin & pH tinggi'
    weaknessText: "<b><color=#81C784>\u2022 KELEMAHAN (EFEKTIF MENETRALKAN):</color></b>\n\u2022
      <b>Kabut Asam Dingin</b> (Asam + Pendingin) & <b>Asam Pelarut Karat</b>.\n\u2022
      Semburan asam langsung merusak mantel lendir sabun alkali secara instan!"
    mutationRiskText: "<b><color=#E57373>\u2022 PANTANGAN (RISIKO MUTASI):</color></b>\n\u2022
      <b>Ramuan Basa</b> (Gel Sabun Beku / Busa Sabun).\n\u2022 Menambah lapisan
      basa membuat tubuhnya semakin licin dan memicu <b>Mutasi Gerak Cepat (SpeedUp
      +40%)</b>."
    buttonLabel: LANJUT  [SPACE]
  - title: "Zombie Api  \u2014  Sifat: Eksotermik & Sangat Cepat"
    subtitle: 'Sifat: Eksotermik & sangat cepat'
    titleColor: {r: 0, g: 0, b: 0, a: 0}
    chemicalDescription: 'Sifat: Eksotermik & sangat cepat'
    weaknessText: "<b><color=#81C784>\u2022 KELEMAHAN (EFEKTIF MENETRALKAN):</color></b>\n\u2022
      <b>Ledakan Es Instan</b> (Pendingin + Katalis) & <b>Gel Sabun Beku</b>.\n\u2022
      Reaksi endotermik drastis menyerap panas tubuhnya dan membekukannya di tempat
      (Root)!"
    mutationRiskText: "<b><color=#E57373>\u2022 PANTANGAN (RISIKO MUTASI):</color></b>\n\u2022
      <b>Katalis Murni Tanpa Es</b>.\n\u2022 Mempercepat laju pembakaran api dan
      memicu <b>Mutasi Aura Buff Kecepatan (AoE Speed Buff)</b> ke zombie di sekitarnya!"
    buttonLabel: LANJUT  [SPACE]
  - title: "Zombie Besi  \u2014  Sifat: Logam Berzirah Tebal (Oksidasi)"
    subtitle: 'Sifat: Logam berzirah tebal (oksidasi)'
    titleColor: {r: 0, g: 0, b: 0, a: 0}
    chemicalDescription: 'Sifat: Logam berzirah tebal (oksidasi)'
    weaknessText: "<b><color=#81C784>\u2022 KELEMAHAN (EFEKTIF MENETRALKAN):</color></b>\n\u2022
      <b>Asam Pelarut Karat</b> (Asam + Katalis) \u2014 <b>Kerusakan 3x Lipat!</b>\n\u2022
      Satu-satunya formula korosif pekat yang sanggup melarutkan zirah besi tebal
      mereka."
    mutationRiskText: "<b><color=#E57373>\u2022 PANTANGAN (RISIKO MUTASI):</color></b>\n\u2022
      <b>Serangan Non-Asam / Dingin Ringan</b>.\n\u2022 Logam zirah memantulkan sebagian
      besar kerusakan dan memicu <b>Mutasi Zirah Mengeras (Harden -40% DMG)</b>."
    buttonLabel: LANJUT  [SPACE]
  - title: "Boss Unstable Amalgam  \u2014  Sifat: Koloid Radioaktif Dua Tahap"
    subtitle: 'Sifat: Koloid radioaktif dua tahap'
    titleColor: {r: 0, g: 0, b: 0, a: 0}
    chemicalDescription: 'Sifat: Koloid radioaktif dua tahap'
    weaknessText: "<b><color=#81C784>\u2022 STRATEGI 2 TAHAP MUTLAK:</color></b>\n\u2022
      <b>Tahap 1:</b> Dinginkan dengan 3x Ramuan Es/Pendingin hingga berstatus <b>Chilled</b>
      (8 detik).\n\u2022 <b>Tahap 2:</b> Saat Chilled, SEGERA lempar <b>Bom Netralisasi</b>
      (Damage 4x Lipat) untuk memusnahkannya!"
    mutationRiskText: "<b><color=#E57373>\u2022 PANTANGAN (BAHAYA FATAL):</color></b>\n\u2022
      Melempar Bom Netralisasi sebelum status Chilled tercapai hanya memberi 12%
      damage dan memicu amukan mutasi!"
    buttonLabel: LANJUT  [SPACE]
