  headerTextColor: {r: 0.96, g: 0.82, b: 0.44, a: 1}
  titleTextColor: {r: 1, g: 1, b: 1, a: 1}
  subtitleTextColor: {r: 0.85, g: 0.8, b: 0.7, a: 0.95}
