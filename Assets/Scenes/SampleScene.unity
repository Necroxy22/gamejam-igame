  m_Name: 
  m_EditorClassIdentifier: 
  runTutorialOnStart: 1
  marie: {fileID: 761744574}
  wizard: {fileID: 0}
  mainCamera: {fileID: 519420031}
  cameraRig: {fileID: 519420033}
  waveManager: {fileID: 251004463}
  harvestPipes: {fileID: 0}
  uiBridge: {fileID: 0}
  alchemy: {fileID: 251004465}
  throwTargeting: {fileID: 416662431}
  tutorialZombiePrefab: {fileID: 8596498634721889842, guid: 2e538ef927976f24e8509bfefd54a35f, type: 3}
  tutorialZombieMoveSpeed: 0.35
  balconyZoomSize: 3.5
  zombieZoomSize: 3.6
  defaultCameraSize: 4.75
  cameraPanSpeed: 2.8
  cameraZoomSpeed: 3.2
  arenaBackgroundRenderer: {fileID: 0}
  marieDialogueText: 'Oh tidak! Itu spesimen mutasi Asam (H<size=70%><sup>+</sup></size>)
    milik Mr. Seven yang kabur dari laboratorium pusat kemarin!


    Korosinya bisa
    melarutkan fondasi menara - aku harus menetralkannya dengan senyawa Basa kuat
    (OH<size=70%><sup>-</sup></size>) dan pendingin!'
  step1Title: KONTROL KAMERA ARENA
  step1Instruction: Gunakan tombol [A] dan [D] (atau Panah Kiri/Kanan) untuk menggeser
    pandangan kamera melihat seluruh arena!
  step2Title: PIPA DISTILASI MENARA
  step2Instruction: Pipa distilasi menara memproduksi bahan kimia dasar secara berkala.
    Klik gelembung Basa (Biru) dan Pendingin (Cyan) untuk memanennya!
  step3aTitle: DISPLAY BAHAN DASAR
  step3aInstruction: 'Pojok Kiri Bawah: Menampilkan persediaan 4 bahan kimia dasar
    (Basa, Pendingin, Asam, Katalis).'
  step3bTitle: HOTBAR RAMUAN (SLOT 1-6)
  step3bInstruction: 'Hotbar: Tempat menyimpan 6 jenis ramuan siap lempar. Tekan
    angka [1]-[6] untuk memilih ramuan aktif!'
  step4Title: MEJA PERACIKAN RAMUAN
  step4Instruction: Klik tombol lingkaran [Crafting] di tengah Hotbar (atau tekan
    tombol [C] / [Tab]) untuk membuka meja peracikan!
  step5aTitle: DAFTAR BAHAN DASAR
  step5aInstruction: '1. Sisi Kiri: Daftar persediaan bahan dasar mentah yang siap
    ditarik (drag) ke dalam kuali.'
  step5bTitle: SLOT KUALI PENCAMPUR
  step5bInstruction: '2. Slot Kuali (slot1 & slot2): Tempat mencampur 2 bahan kimia
    untuk bereaksi membentuk ramuan baru.'
  step5cTitle: INDIKATOR PH & HASIL
  step5cInstruction: '3. Indikator pH & Hasil: Memantau derajat keasaman (pH 0-14)
    dan pratinjau ramuan yang terbentuk.'
  step5dTitle: TAB RESEP LABORATORIUM
  step5dInstruction: '4. Tab RESEP: Membuka laci panduan formula ramuan dan kelemahan
    monster. Klik kartu atau tab untuk membaca panduan!'
  step6DragTitle: PRAKTEK RACIK RAMUAN
  step6DragInstruction: Tarik (drag) 1x Bahan Basa (Biru) dan 1x Bahan Pendingin
    (Cyan) ke dalam kedua slot kuali (slot1 & slot2)!
  step6BrewTitle: SIMPAN RAMUAN KE HOTBAR
  step6BrewInstruction: Campuran siap bereaksi! Klik tombol [Simpan] untuk meracik
    Gel Sabun Beku ke dalam Hotbar!
  conclusionTitle: PERSIAPAN SELESAI!
  conclusionInstruction: Ramuan Gel Sabun Beku siap di Hotbar Slot 1! Pilih slot
    1 lalu klik jalur arena untuk melemparkannya ke arah Zombie Asam!
  goldAccentColor: {r: 1, g: 0.88, b: 0.45, a: 1}
  darkPanelColor: {r: 0.08, g: 0.1, b: 0.14, a: 0.94}
  spotlightDimmerAlpha: 0.38
  dimmerColor: {r: 0.02, g: 0.02, b: 0.04, a: 0.38}
